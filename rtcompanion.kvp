Meta.DisplayName=RT Systems Companion
Meta.Description=The phone companion for RT Systems (CC:Tweaked): players use the Pocket OS from a real phone.
Meta.OS=Windows, Linux
Meta.AarchSupport=Native
Meta.Arch=All
Meta.Author=RT Systems
Meta.URL=
Meta.DisplayImageSource=none:
Meta.EndpointURIFormat= 
Meta.ConfigManifest=rtcompanionconfig.json
Meta.MetaConfigManifest=rtcompanionmetaconfig.json
Meta.ConfigRoot=rtcompanion.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
